{
  "name": "mindspace-journal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node --env-file=.env server/index.js",
    "build": "vite build",
    "start": "node --env-file=.env server/index.js",
    "db:setup": "node prisma/prepare.js && prisma generate && prisma migrate deploy",
    "test": "node --test tests/*.test.js",
    "seed": "node --env-file=.env prisma/seed.js",
    "test:browser": "playwright test",
    "build:hosted": "vite build && node hosted/build.js",
    "test:sync": "npm run build:hosted && node --test hosted/sync.test.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.2.6",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "framer-motion": "^12.12.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.3",
    "prettier": "^3.10.1",
    "prisma": "6.19.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.4.6"
  }
}
